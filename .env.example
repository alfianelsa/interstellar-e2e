# Host Interstellar yang dites (default: dev), TANPA path app. Path tiap app (/warehouse/, /backoffice/,
# /content-management/, /reconcile/, / untuk merchant) ada di tests/helpers/apps.ts.
# JANGAN arahkan ke production.
BASE_HOST=https://interstellar.kalachakra.io

# Akun QA khusus automation. JANGAN pakai akun pribadi / super admin.
# Role-nya harus punya akses ke semua app yang dites (warehouse, backoffice, content-management).
# Akun ini cuma boleh 1 sesi per app: login manual pakai akun ini di app yang sama akan menendang sesi test.
# Kalau password mengandung #, bungkus dengan tanda kutip: E2E_PASSWORD="..." (tanpa kutip, # dianggap komentar).
E2E_EMAIL=
E2E_PASSWORD=

# Opsional, lokal saja: kalau `npx playwright install chromium` gagal ("does not support chromium on mac13"),
# isi PW_CHANNEL=chrome supaya test pakai Google Chrome yang terpasang. Di Jenkins jangan diisi.
PW_CHANNEL=

# --- Inbox email akun QA (login warehouse selalu minta OTP via email) ---
# Email E2E_EMAIL harus masuk ke mailbox ini. OTP dibaca otomatis lewat IMAP.
# Gmail: E2E_IMAP_HOST=imap.gmail.com, password = App Password (bukan password Gmail biasa).
# Kosongkan E2E_IMAP_HOST kalau mau isi OTP manual di browser (jalankan dengan --headed).
E2E_IMAP_HOST=
E2E_IMAP_PORT=993
E2E_IMAP_USER=
E2E_IMAP_PASSWORD=
